    "@tarojs/components": "3.3.20",
    "@tarojs/react": "3.3.20",
    "@tarojs/runtime": "3.3.20",
    "@tarojs/taro": "3.3.20",
    "@types/jest": "^26.0.23",
    "@types/weixin-app": "^2.9.7",
    "axios": "^1.7.9",
    "babel-jest": "^26.6.3",
    "dayjs": "^1.11.2",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "1.15.7",
    "jest": "^26.6.3",
    "mobx": "6.12.0",
    "mobx-react": "7.6.0",
    "react": "^17.0.0",
    "react-dom": "^17.0.0",

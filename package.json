    "@types/webpack-env": "1.18.4",
    "@typescript-eslint/eslint-plugin": "^4.15.1",
    "@typescript-eslint/parser": "^4.15.1",
    "babel-plugin-import": "1.13.8",
    "babel-preset-taro": "3.3.20",
    "eslint": "^6.8.0",

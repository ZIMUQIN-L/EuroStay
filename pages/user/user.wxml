<view class="user-profile">
    <view class="user-profile__info-container">
        <van-col class="user-profile__info-container__upper">
            <image class="user-profile__avatar-img" src="{{userProfileInfo.avatarUrl}}" />
            <van-icon name="records" class="user-profile__edit-icon" />
        </van-col>
        <text class="user-profile__info-container__name">{{userProfileInfo.nickName}}</text>
    </view>

    <van-divider class="divider" />
    <van-cell class="user-intro" titclassle="Self Introduction" label="Hi, I'm {{userProfileInfo.nickName}}. Welcome to my house!"></van-cell>
    <van-divider class="divider" />
    <scroll-view scroll-y="true" class="user-profile__house-container_view" scroll-y="{{true}}">
        <view wx:for="{{userHouseInfo}}" wx:key="_id" wx:for-index="bindex" data-bindex='{{bindex}}'>
            <swiper indicator-dots="true" autoplay="true" interval="true" duration="true" interval="3000" class="user-profile__house-container_swiper">
                <view wx:for="{{item.images}}" wx:for-item="images">
                    <swiper-item>
                        <image class="user-profile_house-container_slide-image" src="{{images}}"></image>
                    </swiper-item>
                </view>
            </swiper>
            <van-cell-group inset>
                <van-row>
                    <van-col span="8">
                        <van-cell title="{{item.location}}" label="{{item.contact}}" border="{{ false }}" />
                    </van-col>
                    <van-col span="10">
                        <van-cell title="{{item.start_date}} to {{item.end_date}}" border="{{ false }}" />
                    </van-col>
                    <van-col span="4">
                        <button class="user-profile_house-container_del-button" bindtap="onDelHouseInfo" data-bindex='{{bindex}}' hover-class="none">删除</button>
                    </van-col>
                </van-row>
            </van-cell-group>
        </view>
    </scroll-view>
    <!-- <view class="user-house">
        <image lazy-load src="https://img.yzcdn.cn/vant/cat.jpeg" bind:touchstart="onClickHouse" class="user-house__img" />
    </view>

    <van-cell class="van-multi-ellipsis--l2" title="House Description" label="Hi, I'm xxx. This is the house from xxx, which locates in Madrid, Spain. This house has 1 bedroom and can accomendate 2 people. There's 1 private bathroom in the room. Wish you can find a joyful staying here. :)">
    </van-cell> -->
    <van-tabbar active="{{ active }}" bind:change="onChange">
        <van-tabbar-item icon="home-o" bind:click="onGoHome">Home</van-tabbar-item>
        <van-tabbar-item icon="search" size="100px" bind:click="onGoPost">Post</van-tabbar-item>
        <van-tabbar-item icon="friends-o" bind:click="onGoProfile">Profile</van-tabbar-item>
    </van-tabbar>

</view>
.user-profile {
    align-items: center;
    width:100%;
    height:100%;
    overflow:hidden;
    justify-content: center;  
    text-align: center；
}
.user-profile__info-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}


.user-profile__avatar-img {
    height: 7rem;
    width: 7rem;
    border-radius: 70px;
}

.user-profile__info-container__upper {
    position: relative;
    display: inline-block;
}

.user-profile__edit-icon {
    position: absolute;
    top: 3px;
    right: 3px;
    width: 13px;
    height: 13px;
}

.user-profile__info-container__name {
    margin: 0.3rem 0;
}

.user-house {
    display: flex;
    align-items: center;
    justify-content: center;
}

.user-house__img {
    width: 95%;
    border-radius: 5px;
    box-shadow: rgba(0, 0, 0, 0.3) 0px 19px 38px, rgba(0, 0, 0, 0.22) 0px 15px 12px;
}

.divider {
    display: flex;
    align-items: center;
    justify-content: center;
}

.van-divider {
    width: 290px;
}

.user-poster {
    width: 100%;
    height: 53vw;
    display: block;
}

.user-links {
    padding: 15px 0;
    font-size: 12px;
    text-align: center;
    background-color: #fff;
}

.user-links .van-icon {
    display: block;
    font-size: 24px;
}

.user-links .van-row {
    padding: 15px 0;
}

.user-profile__house-container_view {
    height: 1050rpx;
    width: 100%;
    align-items: center;
    overflow-y: scroll;
    text-align: center;
}

.user-profile__house-container_swiper {
    height: 230px;
    width: 100%;
}

.user-profile_house-container_slide-image {
    width: 90%;
}

.user-profile_house-container_del-button {
    display: block;
    margin : 10px auto;
    color: rgb(20, 20, 19) !important;
    font-size: 13px;
    background-color: rgb(250, 243, 222);
    box-shadow        : 0 7px 15px rgba(0, 0, 0, 0.2);
}
.user-profile {
    align-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    justify-content: center;
    text-align: center；
}

.user-profile__info-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}


.user-profile__avatar-img {
    height: 7rem;
    width: 7rem;
    border-radius: 70px;
}

.user-profile__info-container__upper {
    position: relative;
    display: inline-block;
}

.user-profile__edit-icon {
    position: absolute;
    top: 3px;
    right: 3px;
    width: 13px;
    height: 13px;
}

.user-profile__info-container__name {
    margin: 0.3rem 0;
}

.user-house {
    display: flex;
    align-items: center;
    justify-content: center;
}

.user-house__img {
    width: 95%;
    border-radius: 5px;
    box-shadow: rgba(0, 0, 0, 0.3) 0px 19px 38px, rgba(0, 0, 0, 0.22) 0px 15px 12px;
}

.divider {
    display: flex;
    align-items: center;
    justify-content: center;
}

.van-divider {
    width: 290px;
}

.user-poster {
    width: 100%;
    height: 53vw;
    display: block;
}

.user-links {
    padding: 15px 0;
    font-size: 12px;
    text-align: center;
    background-color: #fff;
}

.user-links .van-icon {
    display: block;
    font-size: 24px;
}

.user-links .van-row {
    padding: 15px 0;
}

.user-profile__house-container_view {
    height: 1050rpx;
    width: 100%;
    align-items: center;
    overflow-y: scroll;
    text-align: center;
}

.user-profile__house-container_swiper {
    height: 230px;
    width: 100%;
}

.user-profile_house-container_slide-image {
    width: 90%;
}

.user-profile_house-container_del-button {
    display: block;
    margin: 10px auto;
    color: rgb(20, 20, 19) !important;
    font-size: 13px;
    background-color: #9890E344;
    box-shadow: 0 7px 15px rgba(0, 0, 0, 0.2);
}

.user-profile__edit-container {
    position                  : absolute;
    top                       : 0;
    bottom                    : 0;
    left                      : 0;
    right                     : 0;
    padding                   : 16px;
    -webkit-overflow-scrolling: touch;
}

.user-profile__edit-sub-container {
    position        : relative;
    padding         : 16px;
    background-color: #fff;
    width           : 100%;
    height          : 100%;
    box-sizing      : border-box;
}

.user-profile__avatar-wrapper {
    padding: 0;
    width: 56px !important;
    border-radius: 8px;
    margin-top: 40px;
    margin-bottom: 40px;
  }
  
  .user-profile__avatar {
    display: block;
    width: 56px;
    height: 56px;
  }
  
  .container {
    display: flex;
  }

  .user-profile__submit-btn {
  display: block;
  margin : 24px auto;
  color: beige !important;
  background-color: #9890E3BB;
  box-shadow        : 0 5px 13px rgba(0, 0, 0, 0.2);
  }

  .user-profile__description-text {
    margin: 0.5rem;
    margin-bottom: auto;
    display: block;
    white-space: wrap;
    font-size: 1rem;
    font-style: italic;
    text-align: left;
    color: rgb(127, 142, 143);
    text-overflow:ellipsis;
}

.user-profile__cell {
    display: block;
    margin: 1rem;
}

.user-profile__weui-input-description {
    display: block;
    white-space: wrap;
    font-size: 1rem;
    text-align: left;
    color: rgb(127, 142, 143);
    text-overflow:ellipsis;
}
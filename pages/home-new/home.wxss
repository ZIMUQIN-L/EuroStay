.screen {
  position                  : absolute;
  top                       : 0;
  bottom                    : 0;
  left                      : 0;
  right                     : 0;
  padding                   : 16px;
  -webkit-overflow-scrolling: touch;
}

.contact {
  position        : relative;
  padding         : 16px;
  background-color: #fff;
  width           : 100%;
  height          : 100%;
  box-sizing      : border-box;
}

.avatar {
  position     : absolute;
  top          : 16px;
  left         : 16px;
  font-size    : 0;
  border-radius: 50%;
  width        : 160rpx;
  height       : 160rpx;
  overflow     : hidden;
}

.avatar image {
  width : 100%;
  height: 100%;
}

.ava_pa {
  width : 80rpx;
  height: 80rpx;
}

.ava_pa image {
  width : 100%;
  height: 100%;
}

.name {
  height     : 65px;
  font-size  : 2em;
  font-weight: bold;
  text-align : center;
  margin     : 10px 0;
}

.postlist {
  padding-top : 8px;
  padding-left: 32px;
}

.screen1 {
  overflow-y: scroll;
  padding   : 0;
}

.screen1 .contact {
  margin       : 16px;
  height       : auto;
  width        : auto;
  box-shadow   : 0 2px 5px 0 rgba(0, 0, 0, 0.2);
  border-radius: 20rpx;
  overflow     : hidden;
}

.search-container_submit-btn {
  display: block;
  margin : 24px auto;
  color: beige !important;
  background-color: #9890E3BB;
  box-shadow        : 0 5px 13px rgba(0, 0, 0, 0.2);
}

.when-button {
  display: block;
  margin : 24px auto;
  color: rgb(128, 119, 119) !important;
  background-color: rgb(255, 255, 255);
  font-size: 24px !important;
}

.paragraph {
  -webkit-transition: transform ease-in-out 300ms;
  transition        : transform ease-in-out 300ms;
  -webkit-transform : scale(0.6);
  transform         : scale(0.6);
  color             : #999;
  font-size         : 27rpx;
}

.enter.paragraph {
  transform: none;
}

.tag {
  width: 60px !important;
  column-width: 30px !important;
  border-color: hsl(0, 41%, 87%) !important;
}

.typeInfo {
  height     : 34px;
  font-size  : 20px;
  font-weight: bold;
  text-align : center;
  margin     : 8px 0;
  align-items: center;
  vertical-align: center;
  justify-content: center;  
  text-align: center;
  display:flex;
}

.test {
  color: #b0c0eb;
}

.tag-text_selected {
  font-size: 0.8rem;
  color: #9890E3;
}

.tag-text_unselected {
  font-size: 0.8rem;
  color: rgb(44, 46, 48);
}

.swiperHome {
  height: 230px;
  width: 100%;
}
 
.slide-image {
	width: 100%;
}

.search-container_search-btn {
    display: block;
    margin : 10px auto;
    color: #9890e3 !important;
    font-size: 13px;
    background-color: #9890e3;
    box-shadow        : 0 7px 15px rgba(0, 0, 0, 0.2);
}

.swiper-item__container {
  display: flex;
  justify-content: center;
  align-items: center;
}

.slide-image {
  width: 90%;
  height: 90%;
  border: 1px solid #D9D9D9;
  border-radius: 10px;
}

.contact-host-btn {
  width: 5rem;
  font-size: 10px;
  padding: 0;
  margin-top: 1.2rem;
  background-color: #FFD111;
  color: white;
  border-radius: 30px;
}

.van-cell__title {
  text-align: left;
}
.search-container {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 0.3rem 0;
  gap: 0.5em;
  padding: 0 10px;
}

.search-container__input-btn {
  flex: 5;
  width: 100%;
  border-radius: 5px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 1.1rem;
  display: block;
  margin : 10px auto;
  color: #ffffff !important;
  background-color: #9890e3BB;
  box-shadow        : 0 7px 15px rgba(0, 0, 0, 0.2);
}

.search-container__filter-btn {
  flex: 1;
  display: flex;
  justify-content: center;
  width: 100%;
  height: 2.5rem;
  border-radius: 5px;
  align-items: center;
  border: none;
  background: none;
}

.search-container__filter-btn__img {
  height: 20px;
  width: 20px;
}

.container{
  align-items: center;
  width:100%;
  height:100%;
  overflow:hidden;
  justify-content: center;  
  text-align: center；
}

.line{
  width:100%;
  height:20%;
  align-items: center;
}

.list{
  height:1050rpx;
  width:100%;
  align-items: center;
  overflow-y:scroll;
  text-align:center;

}

.list .item{
  height:300rpx;
  width:100%;
  align-items: center;
  align-self: center;
  text-align: center;
  line-height:300rpx;
}

.list .item:nth-child(even){
  align-items: center;
  background: skyblue;
}

.list .item:nth-child(odd){
  align-items: center;
  background: pink;
}

.itemsw{
  text-align: center;
}

.listcss{
  align-items: center;
  height:40%;
  width:100%;
  overflow-y:scroll;
}

.listcss .item{
  align-items: center;
  height:300rpx;
  width:100%;
  text-align: center;
  line-height:300rpx;
}

.listcss .item:nth-child(even){
  background: skyblue;
}

.listcss .item:nth-child(odd){
  background: pink;
}
page {
  color           : #333;
  background-color: #fff;
  overflow        : hidden;
}


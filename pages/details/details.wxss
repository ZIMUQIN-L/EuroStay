
.goods-img {
  width: 100%;
  display: block;
}

.goods-message .van-cell__title {
  font-size: 1rem;
}

.goods-message .van-cell__label {
  color: #9890E3;
  font-size: 1rem;
}

.goods-express {
  color: #999;
  font-size: 12px;
}

.goods-express .van-cell {
  color: #999;
  font-size: 12px;
  padding: 5px 15px;
}

.goods-express .van-col {
  text-align: left;
}

.goods-cell-group {
  margin: 0 0;
}

.goods-cell-group .van-cell__value {
  color: #999;
}

.goods-tag {
  margin-left: 5px;
}

.goods-action {
  position: relative!important;
}

.capacityInfo {
  text-align: center;
  align-items: center;
}

.swiperHome {
  height: 230px;
  width: 100%;
}
 
.slide-image {
	width: 100%;
}

.house-detail__scroll_view {
    height: 1050rpx;
    width: 100%;
    align-items: center;
    overflow-y: scroll;
    text-align: center;
}

.house-detail__description-text {
    margin: 0.5rem;
    margin-bottom: auto;
    display: block;
    white-space: wrap;
    font-size: 1rem;
    font-style: italic;
    text-align: left;
    color: rgb(127, 142, 143);
    text-overflow:ellipsis;
}

.house-detail__timeslot-text {
    margin-top: 0.5rem;
    margin-bottom: -0.5rem;
    display: block;
    white-space: wrap;
    font-size: 1rem;
    font-style:unset;
    text-align: center;
    color: rgb(127, 142, 143);
    text-overflow:ellipsis;
}

.house-detail__tag-text {
    margin: auto;
    font-size: 0.8rem;
    color: #9890E3;
    font-weight: bold;
    border-radius: 0.1rem;
    border-width: thin;
}
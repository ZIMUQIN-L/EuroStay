<include src="../bottom-nav/bottom-nav.wxml" />
<view>
    <view>
        <swiper indicator-dots="true" autoplay="true" interval="true" duration="true" interval="3000" class="swiperHome">
            <view wx:for="{{detailInfo.images}}" wx:for-item="images">
                <swiper-item>
                    <image class="slide-image" src="{{images}}"></image>
                </swiper-item>
            </view>
        </swiper>
    </view>
    <van-cell-group border="{{ false }}">
        <van-cell custom-class="goods-message" title="{{ detailInfo.location }}" label="{{ detailInfo.houseType}}" />
        <van-cell custom-class="capacityInfo">
            <van-col span="14">{{ detailInfo.capacity }} guests </van-col>
        </van-cell>
    </van-cell-group>
    <scroll-view scroll-y="true" class="house-detail__scroll_view" scroll-y="{{true}}">
        <van-divider />
            <text class="house-detail__timeslot-text">Time Slot: {{detailInfo.start_date}} to {{detailInfo.end_date}}</text>
        
        
        <van-divider />
        <view style="display:flex;align-items:center">
        <text class="house-detail__contact-text">联系方式：</text>
        <button bind:tap="onClickConnect" class="house-detail__connect-btn">
            Connect
        </button>
        <!-- <text class="house-detail__contact-text">房主xhs： {{ detailInfo.xhscontact }}</text>
        <button bind:tap="onClickSearch" class="house-detail__connect-btn">
            Connect
        </button> -->
        </view>

        <van-divider />
        <!-- <text class="house-detail__contact-text">房主xhs： {{ detailInfo.xhscontact }}</text>
        <van-divider /> -->
        
        <van-grid column-num="5"  gutter="{{0}}">
            <van-grid-item class="house-detail__tag-text"use-slot wx:for="{{detailInfo.houseSetting}}" wx:if="{{item}}" wx:key="*this" wx:for-index="bindex" data-bindex='{{bindex}}' wx:for-item="item">
                <text class="house-detail__tag-text">{{bindex}}</text>
            </van-grid-item>
            <van-grid-item class="house-detail__tag-text"use-slot wx:for="{{detailInfo.houseSurrounding}}" wx:if="{{item}}" wx:key="*this" wx:for-index="bindex" data-bindex='{{bindex}}' wx:for-item="item">
                <text class="house-detail__tag-text">{{bindex}}</text>
            </van-grid-item>
            <van-grid-item class="house-detail__tag-text"use-slot wx:for="{{detailInfo.preference}}" wx:if="{{item}}" wx:key="*this" wx:for-index="bindex" data-bindex='{{bindex}}' wx:for-item="item">
                <text class="house-detail__tag-text">{{bindex}}</text>
            </van-grid-item>
        </van-grid>
        <van-divider />
        <text class="house-detail__description-text">房屋详情： {{ detailInfo.description }}</text>
        <van-divider />
        <text class="house-detail__description-text">房主换宿目标： {{ detailInfo.ownerTarget }}</text>
        <van-divider />
        <van-divider />
        <text class="house-detail__description-text"></text>
        <van-divider />
        <text class="house-detail__description-text"></text>
    </scroll-view>
</view>
/* pages/userlogin/userlogin.wxss */
.login_container--page {
  position                  : absolute;
  top                       : 0;
  bottom                    : 0;
  left                      : 0;
  right                     : 0;
  padding                   : 16px;
  -webkit-overflow-scrolling: touch;
}

.login_container--box {
  position        : relative;
  padding         : 16px;
  background-color: #fff;
  width           : 100%;
  height          : 100%;
  box-sizing      : border-box;
  align-self      : center;
  align-content   : center;

}

.login_container--button {
  display: block;
  margin : 24px auto;
  size: 40px;
  color: beige !important;
  background-color: rgb(147, 174, 224);
}

.login_container--logo {
  height: 25vh;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2e2525;
  font-size: 120rpx;
  letter-spacing: 5rpx;
  font-weight: bold;
}
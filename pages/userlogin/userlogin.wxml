<view class="login_container--page">
  <view class="login_container--logo">
    EuroStay
  </view>
    <!-- <button class="login_container--button" style="background-color:rgb(141, 221, 141)" open-type="chooseAvatar" bind:tap="onLoginWechat">微信登录</button> -->
    <!-- <button class="login_container--button" style="background-color:rgb(173, 179, 224)" bind:tap="onDirectUse">直接进入</button> -->

    <button class="avatar-container" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <image class="avatar" src="{{avatarUrl}}"></image>
    </button>

  <view class="nickname-container">
    <text class="nickname-label">昵称</text>
    <input type="nickname" class="nickname-input" bindblur="onUserNameInput" placeholder="请输入昵称" />
  </view>
  <button class="login_container--button" style="background-color:rgb(141, 221, 141)"  bind:tap="onLoginWechat">注册</button>

</view>